{
  "name": "harmar",
  "version": "0.1.0",
  "description": "Harmar subtitle API for agents and scripts — CLI, MCP server and typed client. Word-timed transcripts and SRT/VTT for Armenian, Russian, English and 50+ more languages, code-switching included.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "harmar": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "skills", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["subtitles", "transcription", "srt", "vtt", "armenian", "mcp", "cli", "speech-to-text", "captions"],
  "repository": { "type": "git", "url": "https://github.com/fulfilledbyai/harmar.git", "directory": "sdk" },
  "homepage": "https://harmar.ai/developers",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
